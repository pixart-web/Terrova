POSTGRES_DB=terrova
POSTGRES_USER=terrova
POSTGRES_PASSWORD=replace-with-a-random-database-password
DATABASE_URL=postgresql://terrova:replace-with-a-random-database-password@postgres:5432/terrova
PAYLOAD_SECRET=replace-with-at-least-32-random-characters
CMS_SERVICE_TOKEN=replace-with-a-different-32-byte-random-token
CMS_URL=https://studio.terrova.net
WEB_URL=https://terrova.net
NEXT_PUBLIC_CMS_URL=https://studio.terrova.net
NEXT_PUBLIC_SITE_URL=https://terrova.net
CMS_MEDIA_HOST=media.terrova.net
DEFAULT_BRAND_SLUG=terrova
ALLOW_CONTENT_FIXTURES=false
COMMERCE_MODE=stripe
ALLOW_TEST_COMMERCE=false
STRIPE_SECRET_KEY=replace-in-secret-manager
STRIPE_WEBHOOK_SECRET=replace-in-secret-manager
RESEND_API_KEY=replace-in-secret-manager
RESEND_API_URL=https://api.resend.com
EMAIL_FROM_ADDRESS=hello@terrova.net
EMAIL_FROM_NAME=Terrova
POSTHOG_KEY=replace-in-secret-manager
POSTHOG_HOST=https://eu.i.posthog.com
S3_BUCKET=terrova-production-media
S3_REGION=auto
S3_ENDPOINT=https://replace-with-object-storage-endpoint
S3_FORCE_PATH_STYLE=false
S3_ACCESS_KEY_ID=replace-in-secret-manager
S3_SECRET_ACCESS_KEY=replace-in-secret-manager
ALLOW_PRODUCTION_SEED=false
